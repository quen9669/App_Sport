# Copy this file to `.env` (cp .env.example .env) and fill in real values.
# `.env` is ignored by git: secrets never leave your machine.

# --- General ---
# "development" or "production"
APP_ENV=development
# Timezone used to display dates and compute weeks
APP_TIMEZONE=Europe/Luxembourg
# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Backend ---
# SQLAlchemy database URL. SQLite file for now, PostgreSQL-compatible code.
DATABASE_URL=sqlite:///./data/app_sport.db
# Origins allowed to call the API from a browser (the Vite dev server)
CORS_ORIGINS=http://localhost:5173
# Where the browser goes back to after connecting Strava
# (on the PC with Tailscale: https://<machine>.<tailnet>.ts.net, see docs/learning/06-telephone-tailscale.md)
FRONTEND_URL=http://localhost:5173

# --- Frontend ---
# Where the frontend finds the backend API
VITE_API_BASE_URL=http://localhost:8000

# --- Strava (phase 1) ---
# Create an app at https://www.strava.com/settings/api (guide: docs/learning/01-strava-setup.md)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# With Tailscale: https://<machine>.<tailnet>.ts.net/api/strava/callback
STRAVA_REDIRECT_URI=http://localhost:8000/api/strava/callback

# --- Garmin (phase 1) ---
# Garmin Connect login, used by the unofficial `garminconnect` library.
# Leave empty to use file import only (plan B). Guide: docs/learning/02-garmin-setup.md
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Where Garmin session tokens are stored (outside the repository)
GARMIN_TOKENSTORE=~/.app_sport/garmin
# How many days back the first Garmin sync goes
GARMIN_INITIAL_DAYS=90

# --- Scheduled synchronisation ---
SCHEDULER_ENABLED=true
SYNC_INTERVAL_HOURS=3

# --- Security (phase 1) ---
# Key used to encrypt stored tokens. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Sign-in (phase 6) ---
# Argon2 fingerprint of the app password, written by `make set-password` (never the
# password itself). Empty = no login screen: fine on the PC, refused in production.
APP_PASSWORD_HASH=
# How many days a device stays signed in
SESSION_DAYS=30

# --- Production and backups (phase 6) ---
# Built interface served by the backend (`make prod` sets it; leave empty otherwise)
FRONTEND_DIST=
# Nightly database copies (03:30), outside git; how many to keep
BACKUP_DIR=./data/backups
BACKUP_KEEP=14

# --- AI coaches (phase 5) ---
# One key is enough (keep it here only, never commit it). With a Gemini key the
# coaches use Gemini; set COACH_PROVIDER=anthropic to use Claude when both are set.
# Gemini key: https://aistudio.google.com/apikey. Enable billing on the project:
# on the free tier Google may use the prompts (your health data) to improve its products.
GEMINI_API_KEY=
# Claude key: https://console.anthropic.com
ANTHROPIC_API_KEY=
COACH_PROVIDER=
# Empty = the provider's defaults (Gemini: gemini-3.8-flash, summaries with
# gemini-3.5-flash-lite; Claude: claude-sonnet-5-5 and claude-haiku-5-5).
COACH_MODEL=
COACH_LIGHT_MODEL=
# The coaches pause when the month's estimated cost reaches this amount.
COACH_MONTHLY_BUDGET_EUR=10
